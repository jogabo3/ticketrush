# ==========================================
# TicketRush - Git Ignore Rules
# ==========================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Python packaging
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing and code quality
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak

# Local databases
*.db
*.sqlite
*.sqlite3

# Local runtime data
.pipeline-state/
.pipeline-runs/